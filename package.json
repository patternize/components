{
  "name": "@patternize/components",
  "description": "Atomic, animated React components for visualizing algorithms, data structures, tensors and machine-learning architectures (transformers, CNNs).",
  "version": "0.3.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patternize/components.git"
  },
  "homepage": "https://github.com/patternize/components#readme",
  "bugs": {
    "url": "https://github.com/patternize/components/issues"
  },
  "keywords": [
    "react",
    "components",
    "visualization",
    "algorithms",
    "machine-learning",
    "transformers",
    "tensors",
    "attention",
    "data-structures"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./three": {
      "import": {
        "types": "./dist/three.d.ts",
        "default": "./dist/three.js"
      },
      "require": {
        "types": "./dist/three.d.cts",
        "default": "./dist/three.cjs"
      }
    },
    "./catalog.json": "./dist/catalog.json"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsup && npm run build:catalog",
    "build:catalog": "node scripts/build-catalog.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{js,jsx,ts,tsx}'",
    "format": "prettier --write 'src/**/*.{ts,tsx,md}'",
    "workbench": "npm --prefix workbench run dev",
    "workbench:install": "npm --prefix workbench install",
    "workbench:build": "npm --prefix workbench run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@react-spring/web": "^10.0.1",
    "@visx/geo": "^3.12.0",
    "@visx/gradient": "^3.12.0",
    "@visx/group": "^3.12.0",
    "@visx/hierarchy": "^3.12.0",
    "@visx/responsive": "^3.12.0",
    "@visx/scale": "^3.12.0",
    "@visx/shape": "^3.12.0",
    "@visx/text": "^3.12.0",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "react-jss": "^10.10.0",
    "resize-observer-polyfill": "^1.5.1",
    "topojson-client": "^3.1.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "@react-three/drei": ">=9",
    "@react-three/fiber": ">=8",
    "three": ">=0.160"
  },
  "peerDependenciesMeta": {
    "three": { "optional": true },
    "@react-three/fiber": { "optional": true },
    "@react-three/drei": { "optional": true }
  },
  "devDependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@types/topojson-client": "^3.1.5",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.1",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.6.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "none"
  },
  "files": [
    "dist"
  ]
}
